doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Document
    body 
        h1#titre Accueil
        if produits.length > 0
            ul
                each produit in produits
                    li #{produit.nom} - #{produit.prix} €
        else 
            div.alerte Aucun produit disponible
        
<form action="" method="post">
    <div>
        <label for="name">Nom du produit :</label>
        <input type="text" id="name" name="name" placeholder="Ex : T-shirt" required>
    </div>

    <div>
        <label for="price">Prix :</label>
        <input type="number" id="price" name="price" step="0.01" min="0" placeholder="Ex : 19.99" required>
    </div>

    <button type="submit">Ajouter le produit</button>
</form>
